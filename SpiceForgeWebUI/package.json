{
  "name": "spiceforge-webui",
  "private": true,
  "description": "SpiceForge's web front end: plain TypeScript, bundled by esbuild, served by SpiceForgeServer.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && node build.mjs --test && node dist-test/conformance.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
