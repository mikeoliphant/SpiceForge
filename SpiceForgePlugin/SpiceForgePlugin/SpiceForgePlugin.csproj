<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The SpiceForge plugin: a LiveSPICE schematic run by SpiceForge's processor, with a UILayout editor
		(AudioPluginUILayout). AudioPlugSharp 0.8 comes from the Dependencies/AudioPlugSharp submodule (it has no
		packages yet), with UILayout nested in it. Each build makes the DAW bundles in the output folder,
		clap/SpiceForgePlugin and vst3/SpiceForgePlugin.vst3, once AudioPlugSharp's native adapters have been built
		(see README.md, Building); without them it builds the plugin and warns.
	-->
	<Import Project="..\Dependencies\AudioPlugSharp\AudioPlugSharpBridge\build\InRepo.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.0.1</Version>
		<AudioPlugSharpDir>$(MSBuildThisFileDirectory)..\Dependencies\AudioPlugSharp\</AudioPlugSharpDir>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SpiceForge\SpiceForge.csproj" />
		<ProjectReference Include="$(AudioPlugSharpDir)AudioPlugSharp\AudioPlugSharp.csproj" />
		<ProjectReference Include="$(AudioPlugSharpDir)AudioPlugSharpUILayout\AudioPlugSharpUILayout.csproj" />
	</ItemGroup>

	<!-- The image sheets of UILayout's theme and AudioPlugSharp's audio controls aren't in their repositories: render
	     them, before the projects that embed them build, when the checkout doesn't have them yet. -->
	<Target Name="RenderAudioPlugSharpTextures" BeforeTargets="ResolveProjectReferences"
			Condition="!Exists('$(AudioPlugSharpDir)Dependencies\UILayout\UILayout.DefaultTextures\Textures\ImageManifest.xml') Or !Exists('$(AudioPlugSharpDir)AudioPlugSharpUILayout\Textures\ImageManifest.xml')">
		<Message Text="Rendering UILayout's and AudioPlugSharp's image sheets" Importance="High" />
		<Exec Command="dotnet run --project &quot;$(AudioPlugSharpDir)Dependencies\UILayout\DefaultTexturesProcessor&quot; -c Release" />
		<Exec Command="dotnet run --project &quot;$(AudioPlugSharpDir)AudioPlugSharpImageProcessor&quot; -c Release" />
	</Target>

	<Import Project="..\Dependencies\AudioPlugSharp\AudioPlugSharpBridge\build\InRepo.targets" />

</Project>
