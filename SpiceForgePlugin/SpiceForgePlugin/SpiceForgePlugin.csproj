<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Version>0.0.1</Version>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AudioPlugSharp" Version="0.7.13" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.9.0" />
		<PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Microsoft.Xna.Framework.Content.ContentTypeReader" Visible="false" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\SpiceForge\SpiceForge.csproj" />
	  <ProjectReference Include="..\Dependencies\UILayout\UILayout.MonoGame.WindowsDX\UILayout.MonoGame.WindowsDX.csproj" />
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>

	<!-- Build order only: the image processor generates Content/Textures, so it is built first but not referenced. -->
	<ItemGroup>
		<ProjectReference Include="..\SpiceForgeImageProcessor\SpiceForgeImageProcessor.csproj"
						  ReferenceOutputAssembly="false"
						  OutputItemType="ImageProcessorPath" />
	</ItemGroup>

	<!-- Regenerate the sprite sheets and ImageManifest.xml when the image processor's Program.cs is newer than the
	     manifest (or the manifest is missing). This has to run before MonoGame's content builder, which runs before
	     BeforeBuild and packs Content/Textures. -->
	<Target Name="RunImageProcessor"
			DependsOnTargets="ResolveProjectReferences"
			BeforeTargets="RunContentBuilder"
			Inputs="..\SpiceForgeImageProcessor\Program.cs"
			Outputs="Content\Textures\ImageManifest.xml">
		<Message Text="Running SpiceForgeImageProcessor" Importance="High" />
		<Exec Command="dotnet &quot;%(ImageProcessorPath.Identity)&quot;" />
	</Target>
</Project>
