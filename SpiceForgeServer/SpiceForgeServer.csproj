<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpiceForgeServer</RootNamespace>
    <!-- Everything is compiled fully optimized at its first call. With tiering, the runtime swaps in tier-1 code a few
         seconds into a simulation, and that stalled ASIO callbacks past 64- and 128-sample buffers (LessonsLearned.md,
         Audio I/O). Startup and the server check cost no more without it. -->
    <TieredCompilation>false</TieredCompilation>
    <ApplicationIcon>..\Assets\Icon\SpiceForge.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- For packages (SpiceForge.Package): the version, and on Windows no console window (it logs to a file instead).
       Properties of their own, so they don't reach the libraries a publish also builds. -->
  <PropertyGroup Condition="'$(SpiceForgeVersion)' != ''">
    <Version>$(SpiceForgeVersion)</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpiceForgeNoConsole)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- What the About dialog and the startup summary show (About.cs). The SDK appends the git commit to the
       informational version ("0.0.1+f85d36a..."). -->
  <PropertyGroup>
    <Product>SpiceForge</Product>
    <Copyright>Copyright (c) 2026 Mike Oliphant</Copyright>
  </PropertyGroup>

  <!-- The version, from git tags: the one source of it. A release is the commit tagged v<version> (the Release
       workflow tags it), and a build of that commit is that version. A build of a later commit is a development build
       of the next patch, counting the commits since the tag: 9 commits after v0.0.1 is "0.0.2-dev.9", which sorts
       after 0.0.1 and before 0.0.2. After a pre-release tag it goes on from it: 3 after v0.2.0-beta.1 is
       "0.2.0-beta.1.dev.3". Without git or a tag (a shallow clone) it's "0.0.0-dev". Set before GetAssemblyVersion,
       which derives the informational version from Version; SpiceForge.Package reads it from this target too. -->
  <Target Name="SpiceForgeGitVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(SpiceForgeVersion)' == ''">
    <Exec Command="git describe --tags --long --match &quot;v[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SpiceForgeDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="SpiceForgeGitExit" />
    </Exec>
    <PropertyGroup>
      <!-- "v0.0.1-9-g1840144": the tag, the commits since it, and the commit. -->
      <SpiceForgeDescribe Condition="'$(SpiceForgeGitExit)' != '0'"></SpiceForgeDescribe>
      <SpiceForgeDescribe>$(SpiceForgeDescribe.Trim())</SpiceForgeDescribe>
      <SpiceForgeDescribed>$([System.Text.RegularExpressions.Regex]::IsMatch('$(SpiceForgeDescribe)', '^v\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?-\d+-g[0-9a-f]+$'))</SpiceForgeDescribed>
      <SpiceForgeTag Condition="$(SpiceForgeDescribed)">$([System.Text.RegularExpressions.Regex]::Replace('$(SpiceForgeDescribe)', '^v(.+)-(\d+)-g[0-9a-f]+$', '$1'))</SpiceForgeTag>
      <SpiceForgeHeight Condition="$(SpiceForgeDescribed)">$([System.Text.RegularExpressions.Regex]::Replace('$(SpiceForgeDescribe)', '^v(.+)-(\d+)-g[0-9a-f]+$', '$2'))</SpiceForgeHeight>
      <SpiceForgePrerelease Condition="$(SpiceForgeDescribed)">$(SpiceForgeTag.Contains('-'))</SpiceForgePrerelease>
      <SpiceForgeNextPatch Condition="$(SpiceForgeDescribed) And !$(SpiceForgePrerelease)">$([System.Text.RegularExpressions.Regex]::Replace('$(SpiceForgeTag)', '^(\d+)\.(\d+)\.(\d+)$', '$1.$2')).$([MSBuild]::Add($([System.Text.RegularExpressions.Regex]::Replace('$(SpiceForgeTag)', '^\d+\.\d+\.(\d+)$', '$1')), 1))</SpiceForgeNextPatch>

      <Version Condition="!$(SpiceForgeDescribed)">0.0.0-dev</Version>
      <Version Condition="$(SpiceForgeDescribed) And '$(SpiceForgeHeight)' == '0'">$(SpiceForgeTag)</Version>
      <Version Condition="$(SpiceForgeDescribed) And '$(SpiceForgeHeight)' != '0' And $(SpiceForgePrerelease)">$(SpiceForgeTag).dev.$(SpiceForgeHeight)</Version>
      <Version Condition="$(SpiceForgeDescribed) And '$(SpiceForgeHeight)' != '0' And !$(SpiceForgePrerelease)">$(SpiceForgeNextPatch)-dev.$(SpiceForgeHeight)</Version>
    </PropertyGroup>
  </Target>

  <!-- The license texts of what the server ships, beside it in licenses/, for the About dialog (Assets/Licenses). -->
  <ItemGroup>
    <None Include="..\LICENSE" Link="licenses\SpiceForge.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dependencies\LiveSPICE\LICENSE" Link="licenses\LiveSPICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dependencies\LiveSPICE\ComputerAlgebra\LICENSE" Link="licenses\ComputerAlgebra.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Dependencies\JackSharpCore\LICENSE" Link="licenses\JackSharpCore.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\Licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiceForge\SpiceForge.csproj" />
    <!-- JACK through JackSharpCore (Dependencies/JackSharpCore): Windows, Linux (including PipeWire) and macOS. -->
    <ProjectReference Include="..\Dependencies\JackSharpCore\JackSharp\JackSharp.csproj" />
  </ItemGroup>

  <!-- ASIO through NAudio's AsioDevice (duplex, one callback per buffer). Windows only at run time; see Audio/AsioDriver.cs. -->
  <ItemGroup>
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
  </ItemGroup>

  <!-- LiveSPICE's component libraries (diodes, transistors, tubes, op-amps), loaded into the catalogue. -->
  <ItemGroup>
    <None Include="..\Dependencies\LiveSPICE\Circuit\Components\*.xml" Link="Components\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpiceForge.Validate" />
  </ItemGroup>

</Project>
