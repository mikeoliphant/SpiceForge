<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpiceForgeServer</RootNamespace>
    <!-- Everything is compiled fully optimized at its first call. With tiering, the runtime swaps in tier-1 code a few
         seconds into a simulation, and that stalled ASIO callbacks past 64- and 128-sample buffers (LessonsLearned.md,
         Audio I/O). Startup and the server check cost no more without it. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <!-- For packages (SpiceForge.Package): the version, and on Windows no console window (it logs to a file instead).
       Properties of their own, so they don't reach the libraries a publish also builds. -->
  <PropertyGroup Condition="'$(SpiceForgeVersion)' != ''">
    <Version>$(SpiceForgeVersion)</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpiceForgeNoConsole)' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiceForge\SpiceForge.csproj" />
    <!-- JACK through JackSharpCore (Dependencies/JackSharpCore): Windows, Linux (including PipeWire) and macOS. -->
    <ProjectReference Include="..\Dependencies\JackSharpCore\JackSharp\JackSharp.csproj" />
  </ItemGroup>

  <!-- ASIO through NAudio's AsioDevice (duplex, one callback per buffer). Windows only at run time; see Audio/AsioDriver.cs. -->
  <ItemGroup>
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
  </ItemGroup>

  <!-- LiveSPICE's component libraries (diodes, transistors, tubes, op-amps), loaded into the catalogue. -->
  <ItemGroup>
    <None Include="..\Dependencies\LiveSPICE\Circuit\Components\*.xml" Link="Components\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpiceForge.Validate" />
  </ItemGroup>

</Project>
